generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Client {
  id             String        @id @default(cuid())
  name           String
  birthDate      DateTime?
  phone          String?       @unique
  tags           String        @db.LongText
  // Reemplazado por ClientNote (bitácora). Se conserva como respaldo: la
  // migración 20261026140000_add_client_notes lo copió como primera nota y la
  // interfaz ya no lo edita ni lo muestra.
  technicalNotes String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  appointments   Appointment[]
  notes          ClientNote[]
}

// Bitácora de notas de la clienta (alergias, preferencias...). Visible para
// todas las especialistas; cada una edita/borra solo las suyas y la
// administradora todas (ver server/src/routes/clients.js).
model ClientNote {
  id           String         @id @default(cuid())
  clientId     String
  type         ClientNoteType @default(GENERAL)
  text         String         @db.Text
  // Null en notas migradas del antiguo technicalNotes: solo la admin las edita.
  authorUserId String?
  // Nombre congelado al escribir la nota, para que siga legible aunque se
  // borre o renombre la usuaria.
  authorName   String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  client       Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model Service {
  id           String               @id @default(cuid())
  name         String
  basePrice    Float
  durationMinutes Int
  category     ServiceCategory      @default(MANICURE)
  // Solo aplica a MANICURE; en el resto de categorías queda null.
  subcategory  ServiceSubcategory?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  appointments AppointmentService[]
  manicurists  ManicuristService[]
}

model Manicurist {
  id                   String        @id @default(cuid())
  name                 String
  phone                String?
  commissionPercentage Float
  color                String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  appointments         Appointment[]
  services             ManicuristService[]
  categories           ManicuristCategory[]
}

// En la interfaz, "Manicurist" se muestra como "Especialista" (uñas, cejas,
// pestañas...). Los nombres internos se conservan para no migrar tablas.
//
// Qué presta cada especialista = categorías asignadas + servicios explícitos.
// La regla completa está en server/src/lib/manicuristServices.js.
model ManicuristCategory {
  manicuristId String
  category     ServiceCategory
  manicurist   Manicurist      @relation(fields: [manicuristId], references: [id], onDelete: Cascade)

  @@id([manicuristId, category])
}

// Servicios asignados explícitamente a cada especialista: acotan su categoría
// o suman excepciones de otra (ver server/src/lib/manicuristServices.js).
model ManicuristService {
  manicuristId String
  serviceId    String
  manicurist   Manicurist @relation(fields: [manicuristId], references: [id], onDelete: Cascade)
  service      Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([manicuristId, serviceId])
  @@index([serviceId], map: "ManicuristService_serviceId_fkey")
}

model Appointment {
  id                 String               @id @default(cuid())
  clientId           String
  manicuristId       String
  date               DateTime
  status             AppointmentStatus    @default(PENDING)
  confirmed          Boolean              @default(false)
  source             BookingSource        @default(ADMIN)
  finalPricePaid     Float?
  // % de comisión vigente al completar la cita. Se congela igual que en Finance
  // para que cambiar el % de la ficha no reescriba los cierres ya cerrados.
  // Null en citas no completadas: se resuelve con el % actual de la ficha.
  commissionPercentage Float?
  // Forma de pago si se pagó con una sola; null con pago dividido (las partes
  // son los Finance INCOME enlazados, ver `finances`).
  paymentMethod      PaymentMethod?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  googleEventId      String?
  client             Client               @relation(fields: [clientId], references: [id])
  manicurist         Manicurist           @relation(fields: [manicuristId], references: [id])
  services           AppointmentService[]
  // Ingresos generados al completarla: uno por forma de pago.
  finances           Finance[]
  paymentLogs        AppointmentPaymentLog[]

  @@index([clientId], map: "Appointment_clientId_fkey")
  @@index([manicuristId], map: "Appointment_manicuristId_fkey")
}

model Finance {
  id                   String         @id @default(cuid())
  type                 FinanceType
  amount               Float
  description          String
  date                 DateTime
  paymentMethod        PaymentMethod?
  manicuristColor      String?
  manicuristId         String?
  isCommission         Boolean        @default(false)
  commissionPercentage Float?
  // Solo aplica a EXPENSE que no son pago de comisión (isCommission=false).
  // Null = sin categorizar: todo lo registrado antes de esta función, y
  // cualquier egreso nuevo al que no se le asigne categoría.
  expenseCategory      ExpenseCategory?
  // Categoría de servicio a la que se imputa un egreso (p. ej. insumos de
  // pestañas) para el balance por categoría. Null = gasto general del salón.
  // En ingresos de citas se llena si todos sus servicios son de una categoría.
  serviceCategory      ServiceCategory?
  // Cita que generó este ingreso (null en registros manuales y en ingresos
  // antiguos que la migración no pudo enlazar sin ambigüedad).
  appointmentId        String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  appointment          Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([appointmentId])
}

// Registro de cambios de forma de pago de citas ya completadas.
// `previous`/`next` son JSON: [{ "method": "CASH", "amount": 35000 }, ...].
model AppointmentPaymentLog {
  id              String      @id @default(cuid())
  appointmentId   String
  changedByUserId String?
  changedByName   String
  previous        String      @db.Text
  next            String      @db.Text
  createdAt       DateTime    @default(now())
  appointment     Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
}

model AppointmentService {
  appointmentId String
  serviceId     String
  // Congelados al completar la cita, igual que Appointment.commissionPercentage:
  // categoría del servicio y parte de finalPricePaid que le corresponde. Así los
  // reportes por categoría no cambian si luego se edita el servicio. Null en
  // citas no completadas o completadas antes de existir estas columnas (los
  // reportes las calculan al vuelo con los datos actuales del servicio).
  category      ServiceCategory?
  amount        Float?
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service       Service     @relation(fields: [serviceId], references: [id])

  @@id([appointmentId, serviceId])
  @@index([serviceId], map: "AppointmentService_serviceId_fkey")
}

model User {
  id                 String    @id @default(cuid())
  username           String    @unique
  password           String
  role               UserRole  @default(MANICURIST)
  manicuristId       String?   @unique
  googleRefreshToken String?
  googleCalendarId   String?

  pushSubscriptions  PushSubscription[]
}

// Un registro por dispositivo/navegador suscrito a notificaciones push.
// `endpoint` es VarChar y no Text porque MySQL no admite índice único sobre
// TEXT sin longitud de prefijo.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique @db.VarChar(500)
  p256dh    String   @db.VarChar(255)
  auth      String   @db.VarChar(255)
  userAgent String?  @db.VarChar(255)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum AppointmentStatus {
  PENDING
  COMPLETED
  CANCELLED
}

// Origen de la cita: creada por el equipo desde el panel, o reservada por la
// clienta desde el portal público (citas.florcatalan.com).
enum BookingSource {
  ADMIN
  PUBLIC
}

enum PaymentMethod {
  CASH
  BANCOLOMBIA
  NEQUI
}

enum FinanceType {
  INCOME
  EXPENSE
}

// Clasificación operativa de un egreso, para poder comparar el gasto real
// contra las reservas fondoInsumos/cajaEstudio de fundDistribution.
enum ExpenseCategory {
  SUPPLIES // Insumos
  FIXED    // Gastos fijos (arriendo, EPS, cuotas, publicidad recurrente...)
  OTHER    // Categorizado explícitamente como "otro"
}

// Categoría general del servicio. Determina qué especialistas lo prestan y
// cómo se reparten los ingresos y egresos en los reportes de Finanzas.
enum ServiceCategory {
  MANICURE
  PEDICURE
  EYEBROWS // Cejas
  LASHES   // Pestañas
}

// Subcategorías de MANICURE (las demás categorías no tienen).
enum ServiceSubcategory {
  NATURAL_NAIL_OVERLAY // Forrado de uña natural
  ARTIFICIAL_SYSTEMS   // Sistemas artificiales
  MANICURE_SERVICES    // Servicios de manicure
}

enum ClientNoteType {
  ALLERGY    // Alergia
  PREFERENCE // Preferencia
  SERVICE    // Servicio
  GENERAL    // General
}

enum UserRole {
  ADMIN
  MANICURIST
}

model Setting {
  key   String @id
  value String @db.Text
}
