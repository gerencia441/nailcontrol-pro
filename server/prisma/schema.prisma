generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Client {
  id             String        @id @default(cuid())
  name           String
  birthDate      DateTime?
  phone          String?       @unique
  tags           String        @db.LongText
  technicalNotes String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  appointments   Appointment[]
}

model Service {
  id           String               @id @default(cuid())
  name         String
  basePrice    Float
  durationMinutes Int
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  appointments AppointmentService[]
  manicurists  ManicuristService[]
}

model Manicurist {
  id                   String        @id @default(cuid())
  name                 String
  phone                String?
  commissionPercentage Float
  color                String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  appointments         Appointment[]
  services             ManicuristService[]
}

// Servicios que presta cada manicurista. Un conjunto VACÍO significa "presta
// todos los servicios" (ver server/src/lib/manicuristServices.js): así las
// fichas existentes siguen funcionando sin necesidad de un backfill.
model ManicuristService {
  manicuristId String
  serviceId    String
  manicurist   Manicurist @relation(fields: [manicuristId], references: [id], onDelete: Cascade)
  service      Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([manicuristId, serviceId])
  @@index([serviceId], map: "ManicuristService_serviceId_fkey")
}

model Appointment {
  id                 String               @id @default(cuid())
  clientId           String
  manicuristId       String
  date               DateTime
  status             AppointmentStatus    @default(PENDING)
  confirmed          Boolean              @default(false)
  source             BookingSource        @default(ADMIN)
  finalPricePaid     Float?
  paymentMethod      PaymentMethod?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  googleEventId      String?
  client             Client               @relation(fields: [clientId], references: [id])
  manicurist         Manicurist           @relation(fields: [manicuristId], references: [id])
  services           AppointmentService[]

  @@index([clientId], map: "Appointment_clientId_fkey")
  @@index([manicuristId], map: "Appointment_manicuristId_fkey")
}

model Finance {
  id                   String         @id @default(cuid())
  type                 FinanceType
  amount               Float
  description          String
  date                 DateTime
  paymentMethod        PaymentMethod?
  manicuristColor      String?
  manicuristId         String?
  isCommission         Boolean        @default(false)
  commissionPercentage Float?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
}

model AppointmentService {
  appointmentId String
  serviceId     String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service       Service     @relation(fields: [serviceId], references: [id])

  @@id([appointmentId, serviceId])
  @@index([serviceId], map: "AppointmentService_serviceId_fkey")
}

model User {
  id                 String    @id @default(cuid())
  username           String    @unique
  password           String
  role               UserRole  @default(MANICURIST)
  manicuristId       String?   @unique
  googleRefreshToken String?
  googleCalendarId   String?

  pushSubscriptions  PushSubscription[]
}

// Un registro por dispositivo/navegador suscrito a notificaciones push.
// `endpoint` es VarChar y no Text porque MySQL no admite índice único sobre
// TEXT sin longitud de prefijo.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique @db.VarChar(500)
  p256dh    String   @db.VarChar(255)
  auth      String   @db.VarChar(255)
  userAgent String?  @db.VarChar(255)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum AppointmentStatus {
  PENDING
  COMPLETED
  CANCELLED
}

// Origen de la cita: creada por el equipo desde el panel, o reservada por la
// clienta desde el portal público (citas.florcatalan.com).
enum BookingSource {
  ADMIN
  PUBLIC
}

enum PaymentMethod {
  CASH
  BANCOLOMBIA
  NEQUI
}

enum FinanceType {
  INCOME
  EXPENSE
}

enum UserRole {
  ADMIN
  MANICURIST
}

model Setting {
  key   String @id
  value String @db.Text
}
